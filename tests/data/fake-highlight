#!/bin/bash
# A highlight helper for inkline's tests. $1 picks what it does:
#   words    colour argument 1 as a small script of words split at spaces
#            and double quotes (a raw argument keeps its quote marks): the
#            first word of each `|` stage is `command`, `|` is `operator`,
#            digits are `number`, other words `variable`
#   error    as words, plus an error on a word "bad"
#   noplace  as words, plus ":error - - - no place"
#   late     as words, answering after 0.5 s
#   split    as words, sending the first span after 0.1 s and the rest of
#            the reply 2 s later
#   slow     as words, printing its first line after 0.3 s
#   garbage  answer every request with a line that breaks the protocol
#   exit     exit when the first request is complete
#   version  print a wrong first line
#   spew     after the first line, write `:x` lines without end
# When $FAKE_LOG is set, it writes there, as it starts, `CSVM_X:` and the
# value of that variable (`unset` when it is not set), then each request's
# arguments, and `end` when its input ends.
export LC_ALL=C
mode=$1
[[ -n ${FAKE_LOG-} ]] && printf 'CSVM_X:%s\n' "${CSVM_X-unset}" >>"$FAKE_LOG"
if [[ $mode == version ]]; then
    echo not-a-helper
    exec cat >/dev/null
fi
[[ $mode == slow ]] && sleep 0.3
echo "inkline-highlight 1"
if [[ $mode == spew ]]; then
    # Fifty lines a write: about 20 MB/s, without pause.
    lines=$(printf ':x\n%.0s' {1..50})
    while :; do printf '%s\n' "$lines"; done
fi

answer() {
    [[ $mode == exit ]] && exit 0
    if [[ $mode == garbage ]]; then
        echo nonsense
        return
    fi
    [[ $mode == late ]] && sleep 0.5
    [[ $mode == split ]] && sleep 0.1
    local s=${args[1]-} i=0 j n=${#args[1]} tok kind stage_start=1 spans=0
    while ((i < n)); do
        if [[ ${s:i:1} == [[:space:]\"] ]]; then
            ((i++))
            continue
        fi
        j=$i
        while ((j < n)) && [[ ${s:j:1} != [[:space:]\"] ]]; do ((j++)); done
        tok=${s:i:j-i}
        if [[ $tok == '|' ]]; then
            kind=operator
            stage_start=1
        elif [[ $tok =~ ^[0-9]+$ ]]; then
            kind=number
        elif ((stage_start)); then
            kind=command
            stage_start=0
        else
            kind=variable
        fi
        echo ":span 1 $i $j $kind"
        ((spans++ == 0)) && [[ $mode == split ]] && sleep 2
        if [[ $mode == error && $tok == bad ]]; then
            echo ":error 1 $i $j unknown command 'bad'"
        fi
        i=$j
    done
    [[ $mode == noplace ]] && echo ":error - - - no place"
    echo ":end $id"
}

while IFS= read -r line; do
    set -- $line
    case $1 in
        :request) id=$2 args=() ;;
        :cwd) IFS= read -r -N "$2" cwd; IFS= read -r _ ;;
        :arg)
            IFS= read -r -N "$3" a
            IFS= read -r _
            args+=("$a")
            [[ -n ${FAKE_LOG-} ]] && printf '%s:%s\n' "$2" "$a" >>"$FAKE_LOG"
            ;;
        :done) answer ;;
    esac
done
[[ -n ${FAKE_LOG-} ]] && echo end >>"$FAKE_LOG"
