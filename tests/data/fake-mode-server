#!/bin/bash
# A mode server for inkline's tests. $1 picks what it does:
#   words    colour argument 1 as a small script of words split at spaces
#            and double quotes (a raw argument keeps its quote marks): the
#            first word of each `|` stage is `command`, `|` is `operator`,
#            digits are `number`, other words `variable`
#   error    as words, plus an error on a word "bad"
#   noplace  as words, plus ":error - - - no place"
#   late     as words, answering after 0.5 s
#   split    as words, sending the first span after 0.1 s and the rest of
#            the reply 2 s later
#   slow     as words, printing its first line after 0.3 s
#   indent   as words, and names `indent`: answers an `:indent` request
#            with depths counted from the `{`, `(`, `}` and `)` of the
#            argument `:at` names; a script holding `nodepth` gets only
#            `:end`
#   slow-indent  as indent, answering every request after 0.5 s
#   dash-indent  as indent, but sends `-` for the cursor's line unless the
#            line, blanks skipped, starts with `}` or `)`
#   garbage  answer every request with a line that breaks the protocol
#   exit     exit when the first request is complete
#   version  print a wrong first line
#   spew     after the first line, write `:x` lines without end
# When $FAKE_LOG is set, it writes there, as it starts, `CSVM_X:` and the
# value of that variable (`unset` when it is not set), then each request's
# arguments, `at:ARG OFFSET` for each `:indent` request, and `end` when its
# input ends.
export LC_ALL=C
does=$1
[[ -n ${FAKE_LOG-} ]] && printf 'CSVM_X:%s\n' "${CSVM_X-unset}" >>"$FAKE_LOG"
if [[ $does == version ]]; then
    echo not-a-mode-server
    exec cat >/dev/null
fi
[[ $does == slow ]] && sleep 0.3
if [[ $does == indent || $does == slow-indent || $does == dash-indent ]]; then
    echo "inkline-mode 1 indent"
else
    echo "inkline-mode 1"
fi
if [[ $does == spew ]]; then
    # Fifty lines a write: about 20 MB/s, without pause.
    lines=$(printf ':x\n%.0s' {1..50})
    while :; do printf '%s\n' "$lines"; done
fi

answer() {
    [[ $does == exit ]] && exit 0
    if [[ $does == garbage ]]; then
        echo nonsense
        return
    fi
    [[ $does == late || $does == slow-indent ]] && sleep 0.5
    [[ $does == split ]] && sleep 0.1
    local s=${args[1]-} i=0 j n=${#args[1]} tok kind stage_start=1 spans=0
    while ((i < n)); do
        if [[ ${s:i:1} == [[:space:]\"] ]]; then
            ((i++))
            continue
        fi
        j=$i
        while ((j < n)) && [[ ${s:j:1} != [[:space:]\"] ]]; do ((j++)); done
        tok=${s:i:j-i}
        if [[ $tok == '|' ]]; then
            kind=operator
            stage_start=1
        elif [[ $tok =~ ^[0-9]+$ ]]; then
            kind=number
        elif ((stage_start)); then
            kind=command
            stage_start=0
        else
            kind=variable
        fi
        echo ":span 1 $i $j $kind"
        ((spans++ == 0)) && [[ $does == split ]] && sleep 2
        if [[ $does == error && $tok == bad ]]; then
            echo ":error 1 $i $j unknown command 'bad'"
        fi
        i=$j
    done
    [[ $does == noplace ]] && echo ":error - - - no place"
    echo ":end $id"
}

# The depth of the brackets in $1 before byte $2: each `{` or `(` adds
# one, each `}` or `)` takes one off, never going below 0.
depth_at() {
    local s=$1 end=$2 i d=0
    for ((i = 0; i < end; i++)); do
        case ${s:i:1} in
            '{' | '(') ((d += 1)) ;;
            '}' | ')') ((d > 0)) && ((d -= 1)) ;;
        esac
    done
    echo "$d"
}

# Whether $1, blanks skipped, starts with `}` or `)`.
closes() {
    local rest=${1#"${1%%[![:blank:]]*}"}
    [[ $rest == '}'* || $rest == ')'* ]]
}

answer_indent() {
    [[ $does == slow-indent ]] && sleep 0.5
    local s=${args[at_arg]-} off=$at_off
    if [[ $s == *nodepth* ]]; then
        echo ":end $id"
        return
    fi
    local before=${s:0:off} after=${s:off}
    local last=${before##*$'\n'}
    local start=$((off - ${#last}))
    local line=${s:start}
    local new cur
    new=$(depth_at "$s" "$off")
    cur=$(depth_at "$s" "$start")
    closes "${after%%$'\n'*}" && ((new > 0)) && ((new -= 1))
    if closes "${line%%$'\n'*}"; then
        ((cur > 0)) && ((cur -= 1))
    elif [[ $does == dash-indent ]]; then
        cur=-
    fi
    echo ":depth $new $cur"
    echo ":end $id"
}

while IFS= read -r line; do
    set -- $line
    case $1 in
        :request) kind=colours id=$2 args=() ;;
        :indent) kind=indent id=$2 args=() ;;
        :cwd) IFS= read -r -N "$2" cwd; IFS= read -r _ ;;
        :arg)
            IFS= read -r -N "$3" a
            IFS= read -r _
            args+=("$a")
            [[ -n ${FAKE_LOG-} ]] && printf '%s:%s\n' "$2" "$a" >>"$FAKE_LOG"
            ;;
        :at)
            at_arg=$2 at_off=$3
            [[ -n ${FAKE_LOG-} ]] && printf 'at:%s %s\n' "$2" "$3" >>"$FAKE_LOG"
            ;;
        :done)
            if [[ $kind == indent ]]; then answer_indent; else answer; fi
            ;;
    esac
done
[[ -n ${FAKE_LOG-} ]] && echo end >>"$FAKE_LOG"
